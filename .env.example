OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_TIMEOUT=180

SYMBOL=EURUSD
TIMEFRAME=M15
MAGIC=26082202

LIVE_TRADING=true

# STANDARD for normal accounts, CENT for cent accounts
ACCOUNT_UNIT_MODE=STANDARD

# Session controls in DISPLAY currency units
PROFIT_TARGET=20.00
MAX_SESSION_LOSS=10.00

# Execution / risk
MAX_OPEN_POSITIONS=1
RISK_PER_TRADE_PCT=0.25
MIN_CONFIDENCE=0.68
MIN_FINAL_SCORE=0.66
MIN_RR=1.50
SL_ATR_MULT=1.5
TP_ATR_MULT=2.25
DEVIATION_POINTS=20

# Adaptive spread limits (% of mid price)
MAX_SPREAD_PCT_FOREX=0.05
MAX_SPREAD_PCT_METALS=0.15
MAX_SPREAD_PCT_CRYPTO=0.30
MAX_SPREAD_PCT_INDICES=0.15
MAX_SPREAD_PCT_ENERGIES=0.20
MAX_SPREAD_PCT_STOCKS=0.30
MAX_SPREAD_PCT_SYNTHETICS=0.30
MAX_SPREAD_PCT_OTHER=0.20

# Learning / protection
SIMILAR_TRADES_LIMIT=20
MIN_SIMILAR_FOR_WEIGHT=5
COOLDOWN_CANDLES_AFTER_LOSS=1
MAX_CONSECUTIVE_LOSSES=3
PAUSE_CANDLES_AFTER_STREAK=4

# Data
BARS=500

SYMBOL_SCAN_LIMIT=12
LLM_MEMORY_LIMIT=6

AUTO_SESSION_PROFIT_PCT=1.00
AUTO_SESSION_LOSS_PCT=2.00

MAX_BOT_POSITIONS=5
MAX_SYMBOL_POSITIONS=3
MIN_MARGIN_LEVEL_PCT=500.0
MAX_TOTAL_RISK_PCT=3.0
ADD_POSITION_MIN_CONF=0.88
ADD_POSITION_MIN_DISTANCE_ATR=0.35

DYNAMIC_RISK_MIN_PCT=0.20
DYNAMIC_RISK_MAX_PCT=0.75
DYNAMIC_RR_MIN=1.30
DYNAMIC_RR_MAX=2.20
DYNAMIC_SESSION_PROFIT_MIN_PCT=0.60
DYNAMIC_SESSION_PROFIT_MAX_PCT=1.50
DYNAMIC_SESSION_LOSS_MIN_PCT=0.80
DYNAMIC_SESSION_LOSS_MAX_PCT=2.00

MACRO_MICRO_ENABLED=true
MACRO_CONTEXT_FILE=data/macro_context.json
MACRO_API_URL=
MACRO_API_KEY=
MACRO_TIMEOUT=8
MACRO_MAX_AGE_MINUTES=180
MACRO_HIGH_IMPACT_BLOCK_MINUTES=30
MACRO_SCORE_WEIGHT=0.10
MICRO_SCORE_WEIGHT=0.08

ZPI_ENABLED=true
ZPI_API_KEY=
ZPI_BASE_URL=https://api.zpi.web.id
ZPI_TIMEOUT=12
ZPI_NEWS_CACHE_MINUTES=20
ZPI_CALENDAR_CACHE_MINUTES=60
ZPI_NEWS_COUNT=15
ZPI_SENTIMENT_WEIGHT=0.10

ZPI_TECHNICALS_CACHE_MINUTES=10
ZPI_FEAR_GREED_CACHE_MINUTES=60
ZPI_KLINES_CACHE_MINUTES=10
ZPI_TECHNICAL_WEIGHT=0.08
ZPI_FEAR_GREED_WEIGHT=0.05

ADAPTIVE_MARGIN_SIZING=true
MARGIN_FREE_BUFFER_PCT=5.0
MARGIN_VOLUME_SEARCH_STEPS=20
OLLAMA_NUM_PREDICT=180
OLLAMA_RETRY_NUM_PREDICT=110

OLLAMA_EMPTY_RETRY_NUM_PREDICT=72
OLLAMA_EMPTY_COOLDOWN_SEC=20
DETERMINISTIC_FALLBACK_ENABLED=true
DETERMINISTIC_FALLBACK_MIN_TECH=0.92
DETERMINISTIC_FALLBACK_MIN_TVTECH=0.30
